{
  "name": "@toyonix/web-kit",
  "version": "0.1.3",
  "description": "Shared design system, components, and tooling for every toyonix static site.",
  "license": "MIT",
  "author": "ToYoNiX",
  "homepage": "https://github.com/ToYoNiX/web-kit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ToYoNiX/web-kit.git",
    "directory": "packages/web-kit"
  },
  "bugs": "https://github.com/ToYoNiX/web-kit/issues",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "config"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "default": "./dist/storage/index.js"
    },
    "./registry": {
      "types": "./dist/registry/index.d.ts",
      "default": "./dist/registry/index.js"
    },
    "./registry/build": {
      "types": "./dist/registry/build.d.ts",
      "default": "./dist/registry/build.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./next": {
      "types": "./dist/next/index.d.ts",
      "default": "./dist/next/index.js"
    },
    "./css": "./dist/css/index.css",
    "./css/tokens.css": "./dist/css/tokens.css",
    "./css/fonts.css": "./dist/css/fonts.css",
    "./tailwind.css": "./dist/css/tailwind.css",
    "./eslint": "./config/eslint.js",
    "./prettier": "./config/prettier.js",
    "./tsconfig.json": "./config/tsconfig.base.json",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown && node scripts/build-css.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "eslint-config-next": "^16.4.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "radix-ui": "^1.8.1",
    "typescript-eslint": "^8.71.2"
  },
  "peerDependencies": {
    "eslint": "^9.0.0",
    "next": ">=16.0.0 <18.0.0",
    "prettier": "^3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": ">=5.5.0 <6.1.0"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "prettier": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
